# База данных
DB_HOST=db
DB_PORT=5432
# С хоста порт БД наружу не проброшен — доступ через docker exec / pgAdmin
DB_NAME=lipetsk_institutions_db
DB_USER=user
DB_PASS=change-me-strong-password

# pgAdmin (только docker-compose.yml): http://127.0.0.1:5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin

# Администратор карты (создаётся вручную через create_admin.php / уже может быть в backups/)
# Если в пароле есть # или пробелы — возьмите значение в кавычки
ADMIN_LOGIN=change-me-admin-login
ADMIN_PASSWORD="change-me-strong-admin-password"
ADMIN_FULL_NAME=Map Administrator

# Безопасность
ALLOWED_ORIGIN=
SESSION_SECURE=false
DB_SSLMODE=disable

# Production (docker-compose.prod.yml)
WEB_PORT=80
