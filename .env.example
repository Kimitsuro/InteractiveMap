# База данных
DB_HOST=db
DB_PORT=5432
DB_NAME=lipetsk_institutions_db
DB_USER=user
DB_PASS=change-me-strong-password

# pgAdmin (только docker-compose.yml)
PGADMIN_EMAIL=admin@localhost.local
PGADMIN_PASSWORD=change-me-pgadmin

# Безопасность
ALLOWED_ORIGIN=
SESSION_SECURE=false
DB_SSLMODE=disable

# Production (docker-compose.prod.yml)
WEB_PORT=80
