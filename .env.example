# База данных
DB_HOST=db
DB_PORT=5432
# С хоста порт БД наружу не проброшен — доступ через docker exec / pgAdmin
DB_NAME=lipetsk_institutions_db
DB_USER=user
DB_PASS=change-me-strong-password

# pgAdmin (только docker-compose.yml): http://127.0.0.1:5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin

# Администратор карты (создаётся вручную через create_admin.php / уже может быть в backups/)
# Если в пароле есть # или пробелы — возьмите значение в кавычки
ADMIN_LOGIN=change-me-admin-login
ADMIN_PASSWORD="change-me-strong-admin-password"
ADMIN_FULL_NAME=Map Administrator

# Безопасность
# ALLOWED_ORIGIN — с какого сайта браузер может слать запросы к API (CORS).
#   Пусто = только свой домен (обычный режим, без чужих origin).
#   https://ваш-домен.рф = разрешить этот origin (нужно при отдельном фронте/HTTPS).
#   * = разрешить любой сайт (не рекомендуется в production).
ALLOWED_ORIGIN=
# SESSION_SECURE — флаг Secure у cookie сессии админки.
#   false = cookie уходит и по HTTP (dev / localhost).
#   true  = cookie только по HTTPS (ставь на боевом сервере с HTTPS).
SESSION_SECURE=false
# DB_SSLMODE — SSL между PHP и PostgreSQL (параметр sslmode в PDO).
#   disable = без шифрования (нормально, если БД в той же Docker-сети).
#   require / verify-full = требовать SSL (если БД снаружи и нужна защита канала).
DB_SSLMODE=disable

# Production (docker-compose.prod.yml)
WEB_PORT=80
